ConnectionStrings__DefaultConnection=Server=...;Database=...;User Id=...;Password=...;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;

Jwt__Secret=<minimum-32-character-secret-change-this>
Jwt__Issuer=NP.API
Jwt__Audience=NP.Client
Jwt__ExpirationMinutes=1440

Stripe__SecretKey=<stripe-secret-key>
Stripe__WebhookSecret=<stripe-webhook-secret>

# OTP / 2FA email — required for login (Gmail App Password recommended)
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__UseSsl=true
Email__Username=<your_email@gmail.com>
Email__Password=<your_gmail_app_password>
Email__FromAddress=<your_email@gmail.com>
Email__FromName=NutriLife Platform

# CORS — must match the origin the browser connects from
# Local:  http://localhost
# Hosted: https://yourdomain.com
Cors__AllowedOrigins__0=http://localhost

AI__ApiKey=<groq-or-openai-api-key>
AI__Model=llama-3.3-70b-versatile

# Swagger toggle — true locally, false on hosted production
Swagger__Enabled=true
